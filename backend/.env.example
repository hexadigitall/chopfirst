# Supabase PostgreSQL connection via pgBouncer (port 6543 for serverless)
# URL-encode any special chars in the password (e.g. @ → %40)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true

# Google OAuth — from Google Cloud Console OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pilot seed pool (NGN). New orders are blocked once exposure reaches 85% of this.
SEED_POOL=1000000
